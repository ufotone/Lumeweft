{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "first_frame.png" },
    "_meta": { "title": "CANVAS First Frame" }
  },
  "2": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fused_refdelta_r1024_turbo8_mystic07_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "MiniMax H3 Fused Turbo INT8 ConvRot" }
  },
  "3": {
    "class_type": "MiniMaxChunkFeedForward",
    "inputs": { "model": ["2", 0], "chunks": 4, "seq_threshold": 4096 },
    "_meta": { "title": "Low VRAM Feed-Forward Chunking" }
  },
  "4": {
    "class_type": "H3SLAAttention",
    "inputs": {
      "model": ["3", 0], "sparsity_ratio": 0.9, "block_size": "64",
      "min_seq_len": 8192, "dense_last_steps": 0, "protect_audio": true, "enabled": true
    },
    "_meta": { "title": "H3 SLA Attention 0.9/64" }
  },
  "5": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax", "device": "default"
    }
  },
  "6": { "class_type": "VAELoader", "inputs": { "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors" } },
  "7": { "class_type": "VAELoader", "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" } },
  "8": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "prompt": "Cinematic natural motion. Preserve the subject and composition. Audio: synchronized natural ambience.",
      "width": 1152, "height": 640, "length": 124,
      "clip": ["5", 0], "vae": ["6", 0], "first_frame": ["1", 0]
    }
  },
  "9": { "class_type": "RandomNoise", "inputs": { "noise_seed": 42 } },
  "10": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": { "model": ["4", 0], "shift_video": 12, "shift_audio": 3 }
  },
  "11": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "res_multistep" } },
  "12": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["10", 0], "scheduler": "simple", "steps": 4, "denoise": 1 }
  },
  "13": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["10", 0], "conditioning": ["8", 0] }
  },
  "14": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["9", 0], "guider": ["13", 0], "sampler": ["11", 0],
      "sigmas": ["12", 0], "latent_image": ["8", 1]
    }
  },
  "15": { "class_type": "VAEDecode", "inputs": { "samples": ["14", 0], "vae": ["6", 0] } },
  "16": { "class_type": "VAEDecodeAudio", "inputs": { "samples": ["14", 0], "vae": ["7", 0] } },
  "17": { "class_type": "CreateVideo", "inputs": { "images": ["15", 0], "audio": ["16", 0], "fps": 24, "bit_depth": 8 } },
  "18": {
    "class_type": "SaveVideo",
    "inputs": { "video": ["17", 0], "format": "auto", "codec": "auto", "filename_prefix": "video/CANVAS_minimax_h3_fused_sla" },
    "_meta": { "title": "CANVAS Video Output" }
  }
}
